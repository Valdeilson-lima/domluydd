# Configuração do Supabase (Project Settings -> API Keys no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Chave privada de servidor (OBRIGATÓRIA: usada para RLS em orders, catálogo, configurações e Supabase Auth /admin)
# Nunca exponha esta chave com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Cloudinary — Upload de fotos de produtos (apenas a URL otimizada é salva no Supabase)
# Modo recomendado (assinado no servidor): preencha CLOUD_NAME + API_KEY + API_SECRET
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
# Alternativa (upload unsigned): se preferir usar um Upload Preset público, preencha abaixo
# CLOUDINARY_UPLOAD_PRESET=donluydd_produtos
# Pasta opcional no Cloudinary (padrão: donluydd/produtos)
# CLOUDINARY_FOLDER=donluydd/produtos

# URL canônica pública (usada também no link de recuperação de senha do /admin)
NEXT_PUBLIC_SITE_URL=https://pizzariadonluydd.valdeilsonlima.com.br

# Notificações automáticas pelo WhatsApp (Evolution API)
EVOLUTION_API_URL=https://evolution.valdeilsonlima.com.br
EVOLUTION_INSTANCE=domluydd
EVOLUTION_API_KEY=coloque-a-api-key-no-servidor
